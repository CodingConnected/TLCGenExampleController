void PostApplication_Add(void)
{
#ifndef AUTOMAAT
    count x;
    count prio;
    for (prio = 0; prio < prioFCMAX; ++prio)
    {
        x = iFC_PRIOix[prio];
        if (iPrioriteit[prio] && (iStartGroen[prio] < twacht[x])) twacht[x] = (mulv) iStartGroen[prio];
        if (iPrioriteit[prio] && (iStartGroen[prio] < twacht_wtv[x])) twacht_wtv[x] = (mulv) iStartGroen[prio];
    }
    xyprintf(0, 0, "iPrioriteit[hdFC02] = %3d", iPrioriteit[hdFC02]);
    if (TS)
    {
        if (fpt)
        {
            for (x = 0; x < FCMAX; ++x)
            {
                fprintf(fpt, "%4d,", ((twacht_AR_wtv[x] >= 0) && (twacht_AR_wtv[x] < twacht_wtv[x])) ? twacht_AR_wtv[x] : twacht_wtv[x] * (A[x] != 0 || PRIOFC[x]) * R[x]);
            }
            fprintf(fpt, "%7d,", (H[hprio02karbus]) * 50);
            fprintf(fpt, "%7d,", (H[hprio03karbus]) * 50);
            fprintf(fpt, "%7d,", (H[hprio05karbus]) * 50);
            fprintf(fpt, "%7d,", (H[hprio08karbus]) * 50);
            fprintf(fpt, "%7d,", (H[hprio09karbus]) * 50);
            fprintf(fpt, "%7d,", (H[hprio11karbus]) * 50);
            fprintf(fpt, "%7d,", (H[hhd02]) * 50);
            fprintf(fpt, "%7d,", (H[hhd03]) * 50);
            fprintf(fpt, "%7d,", (H[hhd05]) * 50);
            fprintf(fpt, "%7d,", (H[hhd08]) * 50);
            fprintf(fpt, "%7d,", (H[hhd09]) * 50);
            fprintf(fpt, "%7d,", (H[hhd11]) * 50);
            fprintf(fpt, "%7d,", (H[hprio22fiets]) * 50);
            fprintf(fpt, "%7d,", (H[hprio28fiets]) * 50);
            fprintf(fpt, "%7d,", CIF_GUS[uswtv24] & ~BIT8);
            fprintf(fpt, "\n");
        }
    }

#endif
#if (!defined AUTOMAAT && !defined AUTOMAAT_TEST && !defined VISSIM)
    if (TS &&
        (CIF_KLOK[CIF_JAAR] == 2001) &&
        (CIF_KLOK[CIF_MAAND] == 1) &&
        (CIF_KLOK[CIF_DAG] == 1) &&
        (CIF_KLOK[CIF_UUR] == 16) &&
        (CIF_KLOK[CIF_MINUUT] == 0) &&
        (CIF_KLOK[CIF_SECONDE] == 0))
    {
        //stuffkey(F2KEY);
        stuffkey(F5KEY);
        SCH[schisgdebug] = 1;
        //stuffkey(F4KEY);
        //stuffkey(F10KEY); 
    }
#endif

    if (SCH[schisgdebug]) IsgDebug();
    PrioDebug_Add();
}

