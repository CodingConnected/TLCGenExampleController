void post_init_application()
{
#ifndef AUTOMAAT

    int i;
    fpt = fopen("MyFile.csv", "w");
    if (fpt)
    {
        for (i = 0; i < FCMAX; ++i)
        {
            fprintf(fpt, "%4s,", FC_code[i]);
        }
        fprintf(fpt, " prio02,");
        fprintf(fpt, " prio03,");
        fprintf(fpt, " prio05,");
        fprintf(fpt, " prio08,");
        fprintf(fpt, " prio09,");
        fprintf(fpt, " prio11,");
        fprintf(fpt, " hd02,");
        fprintf(fpt, " hd03,");
        fprintf(fpt, " hd05,");
        fprintf(fpt, " hd08,");
        fprintf(fpt, " hd09,");
        fprintf(fpt, " hd11,");
        fprintf(fpt, " fietsprio22,");
        fprintf(fpt, " fietsprio28,");
        fprintf(fpt, " uswtv24,");
        fprintf(fpt, "\n");
    }
#ifndef DUURTEST
    stuffkey(F2KEY);
    stuffkey(CTRLALTF3KEY);
    stuffkey(F4KEY);
#endif
    SCH[schisgdebug] = 0;
#endif
}

