void modulessatus1(boolv* prml[])
{
    register int hml;

    for (hml = 0; hml < MLMAX; hml++)
    {
        xyprintf(hml * 30, 0, "prml[%1d][fc22] = %3d", hml, prml[hml][fc22]);
        xyprintf(hml * 30, 1, "prml[%1d][fc32] = %3d", hml, prml[hml][fc32]);
    }
}
void modulessatus2(boolv* prml[])
{
    register int hml;

    for (hml = 0; hml < MLMAX; hml++)
    {
        xyprintf(hml * 30, 2, "prml[%1d][fc22] = %3d", hml, prml[hml][fc22]);
        xyprintf(hml * 30, 3, "prml[%1d][fc32] = %3d", hml, prml[hml][fc32]);
    }
}

